# Copy to .env for local Docker Compose. These values are for local development only.
APP_ENV=development
APP_SECRET=local-only-change-before-deployment-9c761b22a4f0
POSTGRES_PASSWORD=local-development-only
PORT=8080

# Local inference is built in; no hosted API key is needed for PDF uploads.
# First Docker startup downloads this model into the persistent ollama-data volume.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_NUM_CTX=12288

# model keeps AI-written explanations as the default; fast opts into direct source extraction.
LESSON_GENERATION_MODE=model

# Optional admin tokens for licensed curriculum imports and QA feedback review.
CURRICULUM_IMPORT_TOKEN=
FEEDBACK_ADMIN_TOKEN=
